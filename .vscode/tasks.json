{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run calculator app",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "uvicorn",
        "calculator:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Uvicorn running on http://127\\.0\\.0\\.1:8000"
        }
      }
    }
  ]
}
